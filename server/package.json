{
  "name": "@aranya/server",
  "private": true,
  "version": "2.0.1",
  "type": "module",
  "main": "dist/index.js",
  "scripts": {
    "dev": "tsx watch src/index.ts",
    "build": "tsc -p tsconfig.build.json",
    "start": "node dist/index.js",
    "typecheck": "tsc --noEmit",
    "db:generate": "drizzle-kit generate",
    "db:migrate": "tsx src/db/migrate.ts",
    "db:seed": "tsx src/db/seed.ts",
    "db:reset": "tsx src/db/reset.ts"
  },
  "dependencies": {
    "@aranya/data": "*",
    "@aranya/shared": "*",
    "@hono/node-server": "^2.1.3",
    "@hono/zod-openapi": "^1.6.3",
    "@scalar/hono-api-reference": "^0.12.9",
    "argon2": "^0.45.1",
    "dotenv": "^18.0.5",
    "drizzle-orm": "^0.45.3",
    "hono": "^4.13.12",
    "jose": "^6.2.12",
    "pg": "^8.23.1",
    "pino": "^10.4.0",
    "zod": "^4.6.5"
  },
  "devDependencies": {
    "@types/node": "^26.6.4",
    "@types/pg": "^8.15.4",
    "drizzle-kit": "^0.31.11",
    "tsx": "^4.23.15",
    "vitest": "^5.0.3"
  }
}
