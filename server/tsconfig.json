{
  "extends": "../tsconfig.base.json",
  "compilerOptions": {
    "lib": ["ES2023"],
    "types": ["node"],
    "module": "NodeNext",
    "moduleResolution": "NodeNext",
    "rootDir": ".",
    "noUncheckedIndexedAccess": true,
    "outDir": "dist",
    "noEmit": true,
    "declaration": false,
    "declarationMap": false
  },
  "include": ["src", "tests"]
}
