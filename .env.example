# ---- Runtime ------------------------------------------------------------
NODE_ENV=development
PORT=8787
LOG_LEVEL=info

# ---- Database -----------------------------------------------------------
# Local Docker Compose (docker compose up -d postgres)
DATABASE_URL=postgresql://aranya:aranya@localhost:55432/aranya
# Neon (free tier) — copy the pooled connection string from the Neon console
# DATABASE_URL=postgresql://USER:PASSWORD@ep-xxx-pooler.region.aws.neon.tech/aranya?sslmode=require

# ---- Auth ---------------------------------------------------------------
# openssl rand -base64 48
JWT_SECRET=replace-me-with-a-long-random-string-at-least-32-chars
ACCESS_TOKEN_TTL=900
REFRESH_TOKEN_TTL_DAYS=30
COOKIE_DOMAIN=
# Comma-separated browser origins allowed to call the API (also checked for CSRF)
CORS_ORIGINS=http://localhost:5173

# ---- Seed admin (only used when no admin exists) ------------------------
SEED_ADMIN_EMAIL=admin@aranya.example
SEED_ADMIN_PASSWORD=replace-me-before-seeding

# ---- Seeded demo customers ----------------------------------------------
# Shared password for the seeded demo customers. Leave unset in production:
# they then get a random password nobody knows.
SEED_DEMO_PASSWORD=replace-me-demo-password

# ---- Session cookies -----------------------------------------------------
# lax  = the browser sees one origin (default). Locally Vite proxies /api; in
#        production vercel.json rewrites /api/* to the API. Keep this.
# none = only if you serve the SPA and API from different sites without a proxy.
#        Requires HTTPS and CORS_ORIGINS to list the frontend origin.
COOKIE_SAME_SITE=lax

# ---- Payments -----------------------------------------------------------
# simulated | razorpay
PAYMENT_PROVIDER=simulated
RAZORPAY_KEY_ID=
RAZORPAY_KEY_SECRET=
RAZORPAY_WEBHOOK_SECRET=

# ---- Ops ----------------------------------------------------------------
BODY_LIMIT_BYTES=131072
RATE_LIMIT_WINDOW_MS=60000
RATE_LIMIT_MAX=30
AUTH_RATE_LIMIT_MAX=10
# Proxies in front of the API that append to X-Forwarded-For (2 = Vercel + Render).
# 0 keys rate limits on the socket address and ignores forwarding headers.
TRUST_PROXY_HOPS=0
# Apply pending migrations when the server boots (used on Render)
RUN_MIGRATIONS=false
MAIL_ADAPTER=console
PUBLIC_APP_URL=http://localhost:5173

# ---- Web (build time, optional) -----------------------------------------
# Leave unset to call the same-origin /api. Set only to bypass the proxy.
# VITE_API_URL=https://api.example.com/api

# ---- Tests --------------------------------------------------------------
TEST_DATABASE_URL=postgresql://aranya:aranya@localhost:55432/aranya_test
E2E_DATABASE_URL=postgresql://aranya:aranya@localhost:55432/aranya_e2e
